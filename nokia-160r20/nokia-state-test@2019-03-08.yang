            } // container container-structures

            container container-units {
                description "Test container for units testing.";

                container container-misc {

                    leaf leaf-centipercents {
                        type uint32 {
                            range "0..10000";
                        }
                        units "centipercent";
                        description "Indicates the current relative adjustment of the receive decision threshold voltage.";
                    }

                    leaf leaf-celsius {
                        type int32;
                        units "degrees celsius";
                        description
                            "The temperature threshold for this power supply
                             tray in degrees celsius.";
                    }

                } // container container-misc

            } // container container-units

            container resources {
                description "Test container for resources";

                list memory {
                    key "name";

                    leaf name {
                        type string;
                    }

                    leaf alloc-success {
                        type boolean;
                        description "Successful allocation";
                    }

                } // list memory

            } // container resources

            list persistent-index {
                key "application name";
                description
                    "Index value is firstly get from queue. If queue is empty, value comes from iterator.

                     You can manipulate with queue by command:
                      - 'shell DEBUG_testPersistentIndexQueueAdd <int>' - add value to queue
                      - 'shell DEBUG_testPersistentIndexQueueDump' - print queue
                      - 'shell DEBUG_testPersistentIndexQueueClear' - remove all elements from queue.";

                leaf application {
                    type enumeration {
                        enum "test"                         { value 1; }
                        enum "testapp"                      { value 2; }
                    }
                }

                leaf name {
                    type string {
                        length "1..512";
                    }
                }

                leaf persistent-id-value {
                    type int32;
                }

            } // list persistent-index

            list persistent-index-with-autorange {
                key "test-name";
                description "Persisten index withautorange.";

                leaf test-name {
                    type string {
                        length "1..512";
                    }
                }

                leaf oper-persisten-id {
                    type uint32;
                }

            } // list persistent-index-with-autorange

            container md-auto-id {
                description "Id ranges for MD Auto assignment";

                container persistent-id-range {

                    leaf used-md-auto-id-for-test {
                        type uint32 {
                            range "0..2147483647";
                        }
                    }

                } // container persistent-id-range

            } // container md-auto-id

        } // container test

    } // grouping state-test

