submodule nokia-state-test {

    yang-version "1.1";

    belongs-to nokia-state { prefix "state"; }

    import ietf-yang-types                { prefix "yang"; }
    import nokia-sros-yang-extensions     { prefix "sros-ext"; }
    import nokia-types-sros               { prefix "types-sros"; }


    sros-ext:sros-major-release "rel16";

    organization "Nokia";

    contact
        "Nokia SR OS Support
         Web: <http://www.nokia.com>";

    description
        "Nokia YANG Data model with operational state for Internal test yang to be used for MD-CLI testing on SR OS based routers.

         Copyright 2016 Nokia. All rights reserved. Reproduction of this document
         is authorized on the condition that the foregoing copyright notice is included.

         This nokia-state-test YANG module embodies Nokia's proprietary
         intellectual property. Nokia retains all title and ownership in the
         specification, including any revisions.

         Nokia grants all interested parties a non-exclusive license to use
         and distribute an unmodified copy of this specification in connection with
         management of Nokia products, and without fee, provided this
         copyright notice and license appear on all copies.

         This specification is supplied `as is', and Nokia makes no warranty,
         either express or implied, as to the use, operation, condition, or performance
         of the specification.";

    revision "2019-03-08";

    grouping state-test {
        container test {
            description "Root test. All lists and containers should be inside this list";

            container container-structures {
                description "Container for testing structures supports config groups.";

                leaf leaf-union-address {
                    type union {
                        type types-sros:ip-address;
                        type types-sros:ipv6-address;
                        type yang:mac-address;
                    }
                    description "Ip, Ipv6, Mac address.";
                }

                leaf leaf-bytes-union-enum-int64 {
                    type union {
                        type enumeration {
                            enum "no-limit"                     { value 0; }
                        }
                        type int64 {
                            range "1..max";
                        }
                    }
                    units "bytes";
                    description "Maximum allowed amount of memory that can be allocated for a group.";
                }

                leaf leaf-percent-union-decimal64-string {
                    type union {
                        type decimal64 {
                            range "0..100";
                            fraction-digits 2;
                        }
                        type string {
                            length "5";
                        }
                    }
                    units "percent";
                    description "Relative amount of time used by the busiest task/core.";
                }

                list list-1-key-leafref-string {
                    key "leafref-key1";
                    description "List with leafref key.";

                    leaf leafref-key1 {
                        type leafref {
                            path "../../list-1-key-string/key1";
                        }
                        description "Leafref key for this list.";
                    }

                    leaf leaf-union-address {
                        type union {
                            type types-sros:ip-address;
                            type types-sros:ipv6-address;
                            type yang:mac-address;
                        }
                        description "Ip, Ipv6, Mac address.";
                    }

                    leaf leaf-bytes-union-enum-int64 {
                        type union {
                            type enumeration {
                                enum "no-limit"                     { value 0; }
                            }
                            type int64 {
                                range "1..max";
                            }
                        }
                        units "bytes";
                        description "Maximum allowed amount of memory that can be allocated for a group.";
                    }

                    leaf leaf-percent-union-decimal64-string {
                        type union {
                            type decimal64 {
                                range "0..100";
                                fraction-digits 2;
                            }
                            type string {
                                length "5";
                            }
                        }
                        units "percent";
                        description "Relative amount of time used by the busiest task/core.";
                    }

                } // list list-1-key-leafref-string

                list list-2-keys-enum-int32 {
                    key "key1 key2";
                    description "Entry of summary filter log.";

                    leaf key1 {
                        type enumeration {
                            enum "first"                        { value 0; }
                            enum "second"                       { value 1; }
                            enum "third"                        { value 2; }
